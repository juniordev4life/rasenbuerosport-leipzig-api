{
	"name": "rasenbuerosport-playmaker",
	"version": "1.7.0",
	"description": "RasenBürosport Leipzig - Backend API",
	"type": "module",
	"main": "src/index.js",
	"scripts": {
		"start": "node src/index.js",
		"dev": "node --watch src/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome lint --write .",
		"lint:check": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check --write .",
		"release": "node scripts/release.js",
		"elo:recompute": "node scripts/recompute-all-elo.js",
		"trophies:backfill": "node scripts/trophy-backfill.js",
		"db:proxy": "cloud-sql-proxy rasenbuerosport-leipzig-9d54f:europe-west3:rasenbuerosport-db --port=5433"
	},
	"keywords": [
		"rasenbuerosport",
		"fastify",
		"api"
	],
	"author": "RasenBürosport Leipzig IT",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=24.0.0"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.78.0",
		"@fastify/autoload": "^6.3.1",
		"@fastify/cors": "^11.2.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/rate-limit": "^10.3.0",
		"dotenv": "^17.3.1",
		"fastify": "^5.7.4",
		"firebase-admin": "^13.0.0",
		"pg": "^8.13.0",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@vitest/coverage-v8": "^4.0.18",
		"changelogen": "^0.5.7",
		"pino-pretty": "^13.1.3",
		"vitest": "^4.0.18"
	}
