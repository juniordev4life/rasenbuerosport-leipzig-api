PORT=3001
HOST=0.0.0.0
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/rasenbuerosport

# Firebase Admin SDK — on Cloud Run, uses Application Default Credentials automatically.
# For local dev, set the path to your service account key JSON:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Storage bucket used for the audio match-report mp3s.
# Default Firebase bucket pattern is <project-id>.appspot.com.
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

CORS_ORIGIN=http://localhost:5173

WRAPPED_TRIGGER_SECRET=

# Anthropic API key for the match-report / prediction / wrapped LLM calls.
ANTHROPIC_API_KEY=

# ElevenLabs text-to-speech for the reporter-style audio match report.
# - Voice ID: pick from https://elevenlabs.io/app/voice-library and copy the ID.
# - Model: eleven_v3 is required for inline [tag] audio direction support.
ELEVENLABS_API_KEY=
# Shared fallback voice ID — used when no persona-specific voice is set below.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
# Only `eleven_v3` (alpha) interprets the inline [mood] audio direction
# tags. Every other model reads them aloud as plain text. Default
# behaviour strips the tags before TTS so the audio is clean even when
# the workspace doesn't have v3 access yet. Set to `true` once v3 is
# confirmed available for your account.
ELEVENLABS_KEEP_AUDIO_TAGS=false
# Voice settings (optional overrides, defaults in elevenLabs.services.js).
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_STYLE=0.5

# Persona-specific voice IDs (multi-reporter system). If unset, the
# audio pipeline falls back to ELEVENLABS_VOICE_ID. Voice tuning
# (stability/similarity/style) per persona is hardcoded in
# src/constants/reporters.constants.js — do not override here.
ELEVENLABS_VOICE_ID_KLASSIKER=
ELEVENLABS_VOICE_ID_ANALYST=
ELEVENLABS_VOICE_ID_EUPHORIKER=
